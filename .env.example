# Password per entrare nel sito
APP_PASSWORD=

# Segreto che l'agent usa per leggere/scrivere sulla bacheca (stringa lunga a caso)
INBOUND_SECRET=

# Upstash Redis (console.upstash.com -> il tuo database -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Classifiche modelli AI (chiave gratuita su artificialanalysis.ai)
AA_API_KEY=

# Sveglia dei bot via email: casella comune, il bot giusto si riconosce dal tag (pandoro+syrup@...)
WAKE_EMAIL=pandoro@mail.grokbot.com
# Server di posta in uscita (es. Gmail: smtp.gmail.com, porta 465, la tua email e una "password per le app")
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Mittente (facoltativo, di default SMTP_USER)
MAIL_FROM=

# Calendario: fuso orario (facoltativo, predefinito Europe/Rome)
# CALENDAR_TZ=Europe/Rome
